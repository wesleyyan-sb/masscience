{
  "name": "masscience",
  "version": "2.1.6",
  "description": "Masscience — lean bulk on autopilot",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:bump": "npm version patch --no-git-tag-version && npm run version:sync",
    "test": "npm run version:sync && node js/tests/run-tests.js",
    "web": "npm run version:sync && node scripts/build-web.mjs",
    "build:web": "npm run version:sync && node scripts/build-web.mjs",
    "build:windows": "npm run version:sync && electron-builder --win --x64",
    "build:linux": "npm run version:sync && electron-builder --linux zip --x64",
    "build:linux:appimage": "npm run version:sync && electron-builder --linux AppImage --x64",
    "build:android": "npm run version:sync && npx cap sync android && node scripts/run-android-build.mjs",
    "build:desktop": "npm run version:sync && npm run build:windows && npm run build:linux",
    "build:all": "npm run version:bump && npm run test && npm run build:web && npm run build:desktop && npm run build:android",
    "dev": "python -m http.server 8080",
    "start": "python -m http.server 8080",
    "cap:sync": "npx cap sync android",
    "electron:dev": "electron .",
    "electron:dev:local": "electron . --no-sandbox"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^31.7.4",
    "electron-builder": "^24.13.1"
  },
  "build": {
    "appId": "com.masscience.app",
    "productName": "Masscience",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "js/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!dist/**",
      "!android/**",
      "!scripts/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "zip"
      ]
    }
  }
}
